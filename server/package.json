{
    "name": "pphat-telemetry-worker",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "wrangler dev",
        "deploy": "wrangler deploy",
        "db:create": "wrangler d1 create pphat-telemetry",
        "db:migrate": "wrangler d1 execute pphat-telemetry --remote --file=./schema.sql",
        "db:migrate:local": "wrangler d1 execute pphat-telemetry --local --file=./schema.sql"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^4.20250101.0",
        "typescript": "^5.4.5",
        "wrangler": "^4.114.0"
    }
}
